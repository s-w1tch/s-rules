# 自有重写规则；自写脚本位于 qx/scripts，第三方备份集中在 qx/backup。
# hostname 为全局配置，所有域名必须合并在这一行，重复声明会互相覆盖。
hostname = *.zhihu.com, api.xiaoheihe.cn, gql-fed.reddit.com, *.taobao.com, *.cainiao.com, api.m.jd.com, beta-api.m.jd.com, *.360buyimg.com, storage.jd.com, storage.360buyimg.com, union-click.jd.com, pro.m.jd.com, live.m.jd.com, c.tieba.baidu.com

# MARK: -  知乎 6.62.0
# hostname = *.zhihu.com
# 开屏广告
^https:\/\/api\.zhihu\.com\/commercial_api\/real_time_launch_v2 url reject-200
# 红点
^https:\/\/api\.zhihu\.com\/(moments\/recent|drama\/living-info) url reject-200
# 首页推荐广告
^https:\/\/api\.zhihu\.com\/topstory\/recommend url script-response-body https://raw.githubusercontent.com/s-w1tch/s-rules/refs/heads/main/qx/scripts/zhihu.js
# 回答底部广告
^https:\/\/www\.zhihu\.com\/api\/v4\/answers\/\d+\/recommendations url reject-200
# 问题中间广告
^https:\/\/api\.zhihu\.com\/v4\/questions\/\d+\/answers url script-response-body https://raw.githubusercontent.com/s-w1tch/s-rules/refs/heads/main/qx/scripts/zhihu.js

# MARK: - 小黑盒 1.3.329
# hostname = api.xiaoheihe.cn
# 首页Banner
^https:\/\/api\.xiaoheihe\.cn\/bbs\/app\/feeds\/banner url script-response-body https://raw.githubusercontent.com/s-w1tch/s-rules/refs/heads/main/qx/scripts/xiaoheihe.js
# 游戏库Banner
^https:\/\/api\.xiaoheihe\.cn\/game\/all_recommend\/v2 url script-response-body https://raw.githubusercontent.com/s-w1tch/s-rules/refs/heads/main/qx/scripts/xiaoheihe.js

# MARK: - Reddit 2025.32.0
# hostname = gql-fed.reddit.com
# 首页和评论区广告
^https:\/\/gql-fed\.reddit\.com url script-response-body https://raw.githubusercontent.com/s-w1tch/s-rules/refs/heads/main/qx/scripts/reddit.js

# MARK: - 菜鸟裹裹-支付宝小程序
# hostname = *.taobao.com, *.cainiao.com
# 每日任务
^https?:\/\/[a-zA-Z0-9_.-]+\.taobao\.com\/gw\/mtop\.cainiao\.pubaccount\.daily\.task\.activity\.task\.query url reject-200
# 底部商品推广
^https?:\/\/[a-zA-Z0-9_.-]+\.taobao\.com\/gw\/mtop\.cainiao\.adx\.flyad\.getad url reject-200
# 通用广告请求
^https?:\/\/[a-zA-Z0-9_.-]+\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads url reject-200

# MARK: - 京东 iOS 15.3.30（com.360buy.jdmobile / 170234）
# 覆盖：开屏、首页浮球/浮层、右上角悬浮、搜索框下营销条、营销弹窗、
#       直播小窗、小时购广告、Feed 广告、小程序广告、领券浮球
# 字段依据：原包 Mach-O 真实键名 + 客户端补丁点，详见 qx/scripts/jingdong-ads.js
# 开屏广告：functionId=start 返回空对象，不展示开屏
^https?:\/\/api\.m\.jd\.com\/client\.action\?.*functionId=start(&|$) url reject-dict
^https?:\/\/beta-api\.m\.jd\.com\/client\.action\?.*functionId=start(&|$) url reject-dict
# 首页活动楼层 / 店铺活动
^https?:\/\/api\.m\.jd\.com\/client\.action\?.*functionId=getShopHomeActivityInfo(&|$) url reject-dict
^https?:\/\/api\.m\.jd\.com\/client\.action\?.*functionId=getShopHomeExtendInfo(&|$) url reject-dict
^https?:\/\/api\.m\.jd\.com\/client\.action\?.*functionId=xview2Config(&|$) url reject-dict
# 广告素材图片：只拦明确广告目录，避免商品图被 reject 成白图
^https?:\/\/m15\.360buyimg\.com\/mobilecms\/jfs url reject-img
^https?:\/\/storage\.360buyimg\.com\/.*scs_jingEgg url reject-img
^https?:\/\/(?:[\w-]+\.)*360buyimg\.com\/(?:ad|ads|adt|advert|advertise)\/ url reject-img
# 小时购广告与首页营销接口（先拦截，优先于下方兜底脚本）
^https?:\/\/api\.m\.jd\.com\/client\.action\?.*functionId=(hourlyGoAD|hourlyGoAd|hourlyGoPopup)(&|$) url reject-dict
# 直播小窗数据兜底：functionId 不固定，按关键词兜底
^https?:\/\/api\.m\.jd\.com\/(?:client\.action|api)\?.*[Ff]unctionId=[A-Za-z0-9_]*([Mm]ini[Ll]ive|[Ll]ive[Ww]indow|[Ff]loat[Ll]ive)(&|$) url reject-dict
# 通用响应清理兜底：覆盖全部 client.action / api 请求
# 只删除广告位、浮层、浮球、弹窗、直播小窗容器，未命中广告字段时原样放行
# 注意：本行必须放在 reject 规则之后，QX 按顺序匹配，先命中先生效
^https?:\/\/(?:api|beta-api)\.m\.jd\.com\/(?:client\.action|api) url script-response-body https://raw.githubusercontent.com/s-w1tch/s-rules/refs/heads/main/qx/scripts/jingdong-ads.js

# MARK: - 贴吧 12.22.3
# hostname = c.tieba.baidu.com
# 禁用tiebaads
^http:\/\/c\.tieba\.baidu\.com/tiebaads url reject-200
